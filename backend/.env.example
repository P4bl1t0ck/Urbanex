SECRET_KEY=replace-with-a-local-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_BASE_URL=http://localhost:3000
EMAIL_PROVIDER=console
DEFAULT_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Urbanex <no-reply@localhost>

# Resend: verify your sending domain in Resend, then set these in backend/.env.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_secret_api_key
# DEFAULT_FROM_EMAIL=Urbanex <no-reply@your-verified-domain.com>

# Local development uses SQLite by default.
DB_ENGINE=sqlite

# To use Supabase PostgreSQL, set DB_ENGINE=postgresql and fill these values
# from Supabase Dashboard > Connect. Keep the real values in backend/.env only.
# DB_ENGINE=postgresql
# DB_NAME=postgres
# DB_USER=postgres.your-project-ref
# DB_PASSWORD=your-database-password
# DB_HOST=aws-0-region.pooler.supabase.com
# DB_PORT=5432
# DB_SSLMODE=require
